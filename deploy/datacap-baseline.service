[Unit]
Description=DataCap DC baseline logger (second DMM/PSU, constant 5 A @ 2 V)
After=network-online.target
Wants=network-online.target

# Runs alongside datacap-logger.service (the AC run) as a separate process, so
# a fault on either bench never stops the other. Baseline bench: DMM 000100194,
# PSU 5601.3800k03-113353 (the AC bench is DMM 000100196, PSU ...-113360).
[Service]
Type=simple
User=thomas
WorkingDirectory=/home/thomas/DataCap
# Same clock fix, stop handling and timeout as datacap-logger.service.
ExecStartPre=-+/bin/sh /home/thomas/DataCap/deploy/set-clock-from-github.sh
ExecStart=/home/thomas/datacap-venv/bin/python3 scpi_vi_logger_usb.py --backend @py --psu-backend @py \
    -r USB0::0x0AAD::0x0135::000100194::INSTR \
    --psu-resource USB0::0x0AAD::0x0197::5601.3800k03-113353::0::INSTR \
    --psu-peak-current 5 --psu-voltage 2 --psu-mod-depth 0 \
    -o dummy_test7_PI_USB_DC_baseline_power_log.csv
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
